{
  "name": "roadpulse-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RoadPulse prototype dashboard: GPS event view over public RoadSens-4M detector outputs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run validate:issues && npm run validate:traceability && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:issues": "node scripts/validate-road-issues.mjs",
    "validate:traceability": "node scripts/validate-traceability.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
